{
  "tool_renames": {
    "bash": "shell",
    "view": "read",
    "web_fetch": "webfetch",
    "fetch": "webfetch",
    "web_search": "websearch"
  },
  "parameter_mappings": {
    "write": {
      "file_path": "path",
      "filePath": "path",
      "content": "content"
    },
    "read": {
      "file_path": "path",
      "filePath": "path",
      "limit": "limit",
      "offset": "offset"
    },
    "edit": {
      "file_path": "path",
      "filePath": "path",
      "old_string": "oldString",
      "new_string": "newString",
      "replace_all": "replaceAll"
    },
    "shell": {
      "command": "command",
      "workdir": "workdir",
      "work_dir": "workdir",
      "cwd": "workdir",
      "timeout": "timeout",
      "background": "background",
      "_drop": ["description"]
    },
    "grep": {
      "pattern": "pattern",
      "path": "path",
      "include": "include",
      "glob": "include",
      "case_sensitive": "caseSensitive",
      "literal": "literal",
      "limit": "limit",
      "head_limit": "limit"
    },
    "glob": {
      "pattern": "pattern",
      "path": "path",
      "hidden": "hidden",
      "limit": "limit"
    },
    "webfetch": {
      "url": "url",
      "format": "format",
      "timeout": "timeout"
    },
    "websearch": {
      "query": "query"
    }
  },
  "notes": "OpenCode 2.x tool schema (2.2.1). tool_renames maps tool names a model may emit (from older prompts or other clients) to OpenCode tool names; parameter_mappings then maps parsed parameter names to the names OpenCode expects (read/write/edit take `path`, multi-word names are camelCase). `_drop` lists parameters OpenCode no longer accepts. Unmapped parameters pass through unchanged."
}
