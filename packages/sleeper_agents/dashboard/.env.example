# Dashboard Configuration
# Copy this file to .env and configure your settings

# Authentication
# Password for the initial "admin" user (only used when the user database is
# first created). If left empty, a random password is generated and printed
# once in the dashboard logs.
DASHBOARD_ADMIN_PASSWORD=

# Allow visitors to create (non-admin) accounts from the login page.
# Disabled by default; new passwords must be at least 12 characters.
# Only admin users can use the Build section (launch GPU jobs).
ALLOW_REGISTRATION=false

# GPU Orchestrator API Configuration (for Build category)
# GPU Orchestrator API URL (Windows GPU machine)
GPU_API_URL=http://192.168.0.152:8000

# GPU Orchestrator API Key (must match API_KEY in the GPU Orchestrator .env)
GPU_API_KEY=

# Optional Configuration
# DATABASE_PATH=/path/to/evaluation_results.db
# USE_MOCK_DATA=true   # Use synthetic demo data (a MOCK DATA banner is shown)
# STREAMLIT_DEBUG=1
# CACHE_TTL=3600
