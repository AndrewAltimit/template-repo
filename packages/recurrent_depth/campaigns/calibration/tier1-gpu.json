      "name": "download-huginn-model",
      "kind": "exec",
      "argv": [
        "hf",
        "download",
        "tomg-group-umd/huginn-0125",
        "--revision",
        "bb6621b65e90b6a4b9b29ef88dc83866d450470c",
        "--local-dir",
        "{work}/models/huginn"
      ],
      "checkpoint": false,
      "timeout_s": 3600
    },
