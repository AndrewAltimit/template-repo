        "--model-id",
        "ouro-1.4b-s1",
        "--device",
        "cuda",
        "--family",
        "ouro",
        "--ouro-steps",
        "1",
        "--ouro-exit-threshold",
        "1.0",
        "--trust-remote-code",
        "--no-chat-template"
