{
  "campaign": "calibration-tier1",
  "description": "C1 to C6 on one GPU: white-box checks for all five models, per-step hidden dynamics for Huginn and Ouro, the step-count knob on serial tasks and two-hop facts, and timing with fixed and adaptive loops, one request at a time on the toolkit's own server.",
  "max_wall_hours": 3.5,
  "sync_interval_s": 120,
  "services": {
    "huginn": {
      "argv": [
        "{python}",
        "-m",
        "recurrent_depth",
        "serve",
        "{work}/models/huginn",
        "--port",
        "8100",
        "--model-id",
        "huginn-0125",
        "--device",
        "cuda",
        "--family",
        "huginn",
        "--allow-request-recurrence",
        "--trust-remote-code"
      ],
      "health_url": "http://127.0.0.1:8100/health",
      "start_timeout_s": 900
    },
    "ouro14-s1": {
      "argv": [
        "{python}",
        "-m",
        "recurrent_depth",
