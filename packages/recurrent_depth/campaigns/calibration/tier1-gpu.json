      "name": "capture-huginn-easy",
      "kind": "cli",
      "argv": [
        "capture-hidden",
        "{work}/models/huginn",
        "--text",
        "The capital of France is Paris. The capital of Italy is",
        "--module",
        "transformer.core_block.3",
        "--device",
        "cuda",
        "--trust-remote-code",
        "--out",
        "{out}/trajectory.npy",
        "--unembed-out",
        "{out}/unembed.npy",
        "--forward-kwargs",
        "{\"num_steps\": 32}"
      ],
      "timeout_s": 1800
    },
