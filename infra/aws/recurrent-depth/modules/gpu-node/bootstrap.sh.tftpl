#!/bin/bash
# recurrent-depth node bootstrap (rendered by Terraform into the launch template).
#
# Order matters: the shutdown watchdog is armed before anything else can fail,
# and every exit path uploads the log and powers off. The launch template sets
# instance-initiated shutdown to terminate, so power-off ends billing.
#
# Run parameters come from instance tags (IMDSv2, instance_metadata_tags):
#   RunId     run id; the bundle is read from s3://BUCKET/bundles/<RunId>/
#   MaxHours  wall-clock limit for this node, capped at the tier's hard cap
set -uo pipefail

BUCKET="${bucket}"
REGION="${region}"
TIER="${tier}"
HARD_CAP_HOURS="${hard_cap_hours}"
# SANDBOX is empty on a real node; the tests set it to run this script with stub commands.
SANDBOX="$${RDS_SANDBOX:-}"
LOG="$SANDBOX/var/log/rds-bootstrap.log"
mkdir -p "$(dirname "$LOG")"
exec > >(tee -a "$LOG") 2>&1

imds() {
  local token
  token=$(curl -sf -X PUT http://169.254.169.254/latest/api/token -H "X-aws-ec2-metadata-token-ttl-seconds: 300") || return 1
  curl -sf -H "X-aws-ec2-metadata-token: $token" "http://169.254.169.254/latest/meta-data/$1"
}

# 1. Watchdog: power off at the deadline no matter what happens below.
MAX_HOURS=$(imds tags/instance/MaxHours || echo "$HARD_CAP_HOURS")
if ! [[ "$MAX_HOURS" =~ ^[0-9]+([.][0-9]+)?$ ]]; then MAX_HOURS="$HARD_CAP_HOURS"; fi
MINUTES=$(awk -v h="$MAX_HOURS" -v cap="$HARD_CAP_HOURS" 'BEGIN { if (h > cap) h = cap; m = int(h * 60); if (m < 5) m = 5; print m }')
shutdown -h "+$MINUTES" "recurrent-depth watchdog: $MINUTES minute limit"
echo "watchdog armed: power-off in $MINUTES minutes (tier $TIER, cap $HARD_CAP_HOURS h)"

INSTANCE_ID=$(imds instance-id || echo unknown)
RUN_ID=$(imds tags/instance/RunId || true)

finish() {
  local code=$?
  echo "bootstrap finished with exit code $code; uploading log and powering off"
  if [[ -n "$RUN_ID" ]]; then
    aws s3 cp "$LOG" "s3://$BUCKET/runs/$RUN_ID/node/bootstrap-$INSTANCE_ID.log" --region "$REGION" --only-show-errors || true
  fi
  shutdown -h now
}
trap finish EXIT

if ! [[ "$RUN_ID" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$ ]]; then
  echo "missing or invalid RunId tag; nothing to run"
  exit 1
fi

# 2. Scratch space: stripe the instance-store NVMe drives if the type has them.
SCRATCH="$SANDBOX/scratch"
mkdir -p "$SCRATCH"
mapfile -t DEVICES < <(lsblk -dpno NAME,MODEL | awk '/Instance Storage/ {print $1}')
if (( $${#DEVICES[@]} > 1 )); then
  mdadm --create /dev/md0 --level=0 --raid-devices="$${#DEVICES[@]}" "$${DEVICES[@]}" --force --run
  mkfs.xfs -f /dev/md0 && mount /dev/md0 "$SCRATCH"
elif (( $${#DEVICES[@]} == 1 )); then
  mkfs.xfs -f "$${DEVICES[0]}" && mount "$${DEVICES[0]}" "$SCRATCH"
fi
echo "scratch: $(df -h "$SCRATCH" | tail -1)"

# 3. Bundle: manifest, plans, the toolkit wheel, optional requirements.txt.
BUNDLE="$SANDBOX/opt/rds/bundle"
mkdir -p "$BUNDLE"
aws s3 cp "s3://$BUCKET/bundles/$RUN_ID/" "$BUNDLE/" --recursive --region "$REGION" --only-show-errors || exit 1
[[ -f "$BUNDLE/manifest.json" ]] || { echo "bundle has no manifest.json"; exit 1; }

# 4. Environment: a venv with pinned model-side requirements, then the toolkit.
python3 -m venv "$SANDBOX/opt/rds/venv"
VENV="$SANDBOX/opt/rds/venv/bin"
"$VENV/pip" install --quiet --upgrade pip
if [[ -f "$BUNDLE/requirements.txt" ]]; then
  "$VENV/pip" install --quiet -r "$BUNDLE/requirements.txt" || exit 1
fi
WHEEL=$(ls "$BUNDLE"/recurrent_depth-*.whl 2>/dev/null | head -1)
[[ -n "$WHEEL" ]] || { echo "bundle has no recurrent_depth wheel"; exit 1; }
"$VENV/pip" install --quiet "$WHEEL[aws]" || exit 1

# 5. Run. The campaign checkpoints every stage to s3://BUCKET/runs/<RunId>/ and
#    enforces its own max_wall_hours inside the watchdog limit.
export HF_HOME="$SCRATCH/hf" HF_HUB_DISABLE_TELEMETRY=1 AWS_REGION="$REGION" AWS_DEFAULT_REGION="$REGION"
mkdir -p "$SCRATCH/work"
cd "$SCRATCH/work" || exit 1
"$VENV/recurrent-depth" campaign run "$BUNDLE/manifest.json" \
  --store "s3://$BUCKET/" --run-id "$RUN_ID" --work-dir "$SCRATCH/work"
